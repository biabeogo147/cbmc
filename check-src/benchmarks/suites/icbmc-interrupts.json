{
  "suite_name": "icbmc-interrupts",
  "description": "i-CBMC interrupt benchmark suite. Full upstream corpus is collected; large runnable cases are pending normalization.",
  "enabled": false,
  "runs": 5,
  "warmups": 1,
  "variants": ["stock_cprover_async", "improved_pipeline"],
  "cases": [
    {
      "name": "icbmc-logger",
      "enabled": false,
      "reason": "Smoke-only normalized case. Do not use as the headline i-CBMC benchmark; enable after selecting and normalizing larger collected upstream cases.",
      "root": "check-src/benchmark-sources/icbmc/logger/improved-pipeline",
      "variant_roots": {
        "stock_cprover_async": "check-src/benchmark-sources/icbmc/logger/stock-cprover-async",
        "improved_pipeline": "check-src/benchmark-sources/icbmc/logger/improved-pipeline"
      },
      "sources": ["main.c", "model.c", "isr.c"],
      "include_dirs": ["."],
      "isr_sources": ["isr.c"],
      "isr_functions": ["task_measure", "task_communicate"],
      "entry_function": "main",
      "properties": [],
      "unwind": 3,
      "defines": [],
      "expected_result": "same-result",
      "timeout_sec": 300,
      "memory_limit_mb": 4096
    }
  ]
}
