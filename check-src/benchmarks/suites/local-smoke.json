{
  "suite_name": "local-smoke",
  "description": "Small local check-src ISR and interleaving smoke inputs.",
  "enabled": true,
  "runs": 1,
  "warmups": 0,
  "variants": ["stock_cprover_async", "improved_pipeline"],
  "cases": [
    {
      "name": "t-isr-single-file",
      "enabled": true,
      "root": "check-src/simple-benchmarks",
      "sources": ["t_isr.c"],
      "include_dirs": ["."],
      "isr_sources": ["t_isr.c"],
      "isr_functions": ["isr1", "isr2"],
      "entry_function": "main",
      "properties": [],
      "unwind": 3,
      "defines": [],
      "expected_result": "same-result",
      "timeout_sec": 120,
      "memory_limit_mb": 2048
    },
    {
      "name": "t-isr-added-single-file",
      "enabled": true,
      "root": "check-src/simple-benchmarks",
      "sources": ["t_isr_added.c"],
      "include_dirs": ["."],
      "isr_sources": ["t_isr_added.c"],
      "isr_functions": ["isr1", "isr2"],
      "entry_function": "main",
      "properties": [],
      "unwind": 3,
      "defines": [],
      "expected_result": "same-result",
      "timeout_sec": 120,
      "memory_limit_mb": 2048
    },
    {
      "name": "t-isr-multifile",
      "enabled": true,
      "root": "check-src/simple-benchmarks/t_isr_multifile",
      "sources": ["harness.c", "task_define/task.c", "isr_define/isr.c"],
      "include_dirs": [".", "task_define", "isr_define"],
      "isr_sources": ["isr_define/isr.c"],
      "isr_functions": ["isr1", "isr2"],
      "entry_function": "main",
      "properties": [],
      "unwind": 3,
      "defines": [],
      "expected_result": "same-result",
      "timeout_sec": 120,
      "memory_limit_mb": 2048
    },
    {
      "name": "t-interleaving",
      "enabled": false,
      "reason": "Non-ISR smoke input kept documented; enable after defining ISR entry points.",
      "root": "check-src/simple-benchmarks",
      "sources": ["t_interleaving.c"],
      "include_dirs": ["."],
      "isr_sources": ["t_interleaving.c"],
      "isr_functions": ["isr_placeholder"],
      "entry_function": "main",
      "properties": [],
      "unwind": 3,
      "defines": [],
      "expected_result": "same-result",
      "timeout_sec": 120,
      "memory_limit_mb": 2048
    }
  ]
}
