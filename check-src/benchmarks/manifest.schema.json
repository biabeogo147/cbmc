{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check-src benchmark suite manifest",
  "type": "object",
  "required": ["suite_name", "description", "enabled", "cases"],
  "properties": {
    "suite_name": { "type": "string" },
    "description": { "type": "string" },
    "enabled": { "type": "boolean" },
    "runs": { "type": "integer", "minimum": 1 },
    "warmups": { "type": "integer", "minimum": 0 },
    "variants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "root",
          "sources",
          "include_dirs",
          "isr_sources",
          "isr_functions",
          "entry_function",
          "unwind",
          "timeout_sec",
          "memory_limit_mb"
        ],
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "reason": { "type": "string" },
          "root": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "include_dirs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "isr_sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "isr_functions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "entry_function": { "type": "string" },
          "properties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "unwind": { "type": "integer", "minimum": 0 },
          "defines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_result": { "type": "string" },
          "timeout_sec": { "type": "integer", "minimum": 1 },
          "memory_limit_mb": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
